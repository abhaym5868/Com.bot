# ==============================================================================
# CHANGELOG WIDGET — ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Backend Configuration: Copy backend/.env.example to backend/.env
# Frontend Configuration: Copy frontend/.env.example to frontend/.env
# ==============================================================================

# Backend (FastAPI + MongoDB)
# ---------------------------
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# JWT_SECRET_KEY=<GENERATE_A_RANDOM_SECRET>
# Note: Generate via python -c "import secrets; print(secrets.token_urlsafe(32))"
# FRONTEND_URL=http://localhost:5173
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend (React + Vite + Coss UI)
# ---------------------------------
# VITE_API_BASE_URL=http://127.0.0.1:8000
