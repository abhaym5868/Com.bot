# ==============================================================================
# CHANGELOG WIDGET — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in your environment-specific values below.
# 3. NEVER commit real secrets or production .env files to source control.
# ==============================================================================

# ── App & Environment ─────────────────────────────────────────────────────────
APP_NAME="Changelog Widget"
APP_VERSION="2.0.0"

# Set to "production" in live environments to enforce security checks:
# - Disables simulation tokens in API responses
# - Enforces HTTPS-only cookies (COOKIE_SECURE=True)
# - Requires high-entropy JWT_SECRET_KEY (at least 32 characters)
# - Restricts CORS origins strictly to FRONTEND_URL
# - Sanitizes internal server error and DB connection messages
ENVIRONMENT="development"

# ── CORS & Allowed Origins ───────────────────────────────────────────────────
# In production, must be the exact HTTPS origin of your deployed frontend
FRONTEND_URL="http://localhost:5173"
# Optional comma-separated list of additional allowed origins (e.g. https://admin.yourdomain.com)
CORS_ORIGINS=

# ── MongoDB Connection ───────────────────────────────────────────────────────
# MongoDB Atlas connection string (or local MongoDB URI)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGO_URI=
DATABASE_NAME="changelog_db"

# ── JWT & Authentication ─────────────────────────────────────────────────────
# In DEVELOPMENT & PRODUCTION: Set a unique, cryptographically random secret of >= 32 chars!
# Generate one via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<GENERATE_A_RANDOM_SECRET>
JWT_ALGORITHM=HS256

# Access token lifespan in minutes (default: 15)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifespan in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# Token expiration times for email verification simulation and password reset
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ── Cookie Security ──────────────────────────────────────────────────────────
# In development (HTTP): False
# In production (HTTPS): Automatically enforced to True
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# ── Admin Bootstrap (Production Role Protection) ─────────────────────────────
# In production, users CANNOT gain admin rights via email name patterns.
# Specify a comma-separated list of initial admin email addresses below:
ADMIN_EMAILS="admin@example.com"
