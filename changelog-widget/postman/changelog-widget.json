    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "changelog_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "changelog_slug",
      "value": "",
      "type": "string"
    },
    {
      "key": "reaction_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints: registration, authentication, session renewal, and password reset flows.",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}",
                  "if (jsonData.refresh_token) {",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Mercer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "signup"
              ]
            },
            "description": "Registers a new user account. First registered user in the database automatically receives the ADMIN role."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}",
                  "if (jsonData.refresh_token) {",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates user with email and password, returning JWT access and refresh tokens along with httpOnly cookies."
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('access_token', jsonData.access_token);",
                  "}",
                  "if (jsonData.refresh_token) {",
                  "    pm.collectionVariables.set('refresh_token', jsonData.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates refresh token and issues a new access token. Previous refresh token is invalidated to prevent token reuse."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('access_token', '');",
                  "pm.collectionVariables.set('refresh_token', '');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the active refresh token and clears authentication session cookies."
          }
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.simulation_token) {",
                  "    pm.collectionVariables.set('reset_token', jsonData.simulation_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Initiates password recovery flow. In development mode, returns a simulation_token in JSON for testing."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"NewSecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "reset-password"
              ]
            },
            "description": "Completes password reset using verification token and replaces old password."
          }
        }
      ]
    },
    {
      "name": "Changelog",
      "description": "Changelog authoring, publishing, public discovery, and lifecycle management.",
      "item": [
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('changelog_id', jsonData.id);",
                  "}",
                  "if (jsonData.slug) {",
                  "    pm.collectionVariables.set('changelog_slug', jsonData.slug);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI Assistant Integration v2.0\",\n  \"content_markdown\": \"# AI Assistant v2.0\\n\\nWe are excited to launch our brand new AI features:\\n- ⚡ Instant answers\\n- 🔍 Semantic code search\\n- 🛡️ Advanced security validation\\n\\n```python\\n# Quick example\\nresult = assistant.query('hello')\\n```\",\n  \"category\": \"NEW\",\n  \"cover_image\": \"https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe\",\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/changelog",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "changelog"
              ]
            },
            "description": "Creates a new changelog post (Admin only). Auto-generates unique URL-friendly slug if not specified."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog?page=1&limit=10&category=NEW&search=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "changelog"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-indexed)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Entries per page"
                },
                {
                  "key": "category",
                  "value": "NEW",
                  "description": "Filter by category: NEW | IMPROVED | FIXED"
                },
                {
                  "key": "status",
                  "value": "PUBLISHED",
                  "disabled": true,
                  "description": "Filter by status: DRAFT | PUBLISHED (Admin only)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Keyword search across title and markdown content"
                }
              ]
            },
            "description": "Lists changelog entries sorted newest first. Public visitors strictly see PUBLISHED entries; admins can view drafts."
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_slug}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "changelog",
                "{{changelog_slug}}"
              ]
            },
            "description": "Fetches a single changelog post by slug or MongoDB ObjectId. Drafts return 404 for unauthenticated visitors."
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI Assistant Integration v2.1 (Performance Boost)\",\n  \"content_markdown\": \"# AI Assistant v2.1\\n\\n- 🚀 25% lower latency\\n- 🔒 Token refresh bug fixed\\n- 🎨 Dark mode timeline polish\",\n  \"category\": \"IMPROVED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "changelog",
                "{{changelog_id}}"
              ]
            },
            "description": "Updates an existing changelog post (Admin only)."
          }
        },
        {
          "name": "Publish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}/publish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "changelog",
                "{{changelog_id}}",
                "publish"
              ]
            },
            "description": "Publishes a draft changelog entry, timestamps published_at, and broadcasts it to the public timeline and notification center."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "changelog",
                "{{changelog_id}}"
              ]
            },
            "description": "Permanently removes a changelog entry and cascades deletion to all associated user reactions (Admin only)."
          }
        }
      ]
    },
    {
      "name": "Reactions",
      "description": "Emoji reactions (❤️, 🎉, 🚀) on published changelog entries.",
      "item": [
        {
          "name": "Add",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('reaction_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changelog_id\": \"{{changelog_id}}\",\n  \"reaction\": \"🚀\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reactions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "reactions"
              ]
            },
            "description": "Adds an emoji reaction (❤️, 🎉, 🚀) to a published changelog post. Duplicate reactions by the same user on the same post are blocked with 409 Conflict."
          }
        },
        {
          "name": "Remove",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reactions/{{reaction_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "reactions",
                "{{reaction_id}}"
              ]
            },
            "description": "Removes a user's previously added reaction. Only the reacting user or an admin can delete the reaction."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "description": "What's New notification badge and read state management.",
      "item": [
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications?limit=5",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5",
                  "description": "Maximum recent updates to return in drawer"
                }
              ]
            },
            "description": "Returns unread count (published updates after last_viewed_changelog_date) and recent published updates."
          }
        },
        {
          "name": "Mark Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/mark-read",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications",
                "mark-read"
              ]
            },
            "description": "Updates last_viewed_changelog_date to current timestamp, clearing the unread notification badge."
          }
        }
      ]
    },
    {
      "name": "Feed",
      "description": "Public JSON feed for external syndication, embeds, and RSS-style consumers.",
      "item": [
        {
          "name": "Public Feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/feed?page=1&limit=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "changelog",
                "feed"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Updates per page (max 100)"
                }
              ]
            },
            "description": "Public, unauthenticated JSON feed of published changelogs sorted newest first with 5-minute Cache-Control header."
          }
        }
      ]
    }
  ]
}
