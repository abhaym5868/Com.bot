{
  "info": {
    "name": "Changelog Widget API",
    "_postman_id": "c6a1e948-2b81-4228-b0ec-a4e954c25983",
    "description": "Complete Postman collection for Changelog Widget API including Authentication, Changelog Management, Reactions, Notifications, and Public JSON Feed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
