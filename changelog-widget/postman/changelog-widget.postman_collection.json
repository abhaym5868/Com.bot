  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints: registration, login, token refresh, CSRF token, email verification, and password reset flows.",
      "item": [
        {
          "name": "CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.csrf_token) {",
                  "    pm.collectionVariables.set('csrf_token', jsonData.csrf_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/csrf",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "csrf"]
            },
            "description": "Retrieves the double-submit CSRF token and sets the csrf_token cookie."
          }
        },
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var tokenHeader = pm.response.headers.get('X-Email-Verification-Token');",
                  "if (tokenHeader) {",
                  "    pm.collectionVariables.set('verification_token', tokenHeader);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Mercer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "signup"]
            },
            "description": "Registers a new user account. First registered user bootstraps as ADMIN. Tokens are set in httpOnly cookies."
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{verification_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-email"]
            },
            "description": "Verifies email address using verification token simulated in development header."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"SecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates credentials, sets httpOnly access_token (15m) and refresh_token (7d) cookies, and sets csrf_token cookie."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Returns current authenticated user profile using cookie session or Bearer token."
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Performs refresh token rotation: reads httpOnly refresh cookie, invalidates old token, and issues a fresh token pair in cookies."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes active refresh session in MongoDB and clears access_token, refresh_token, and csrf_token cookies."
          }
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.simulation_token) {",
                  "    pm.collectionVariables.set('reset_token', jsonData.simulation_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Generates password reset simulation token. Generic message prevents email enumeration."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"NewSecretPass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "description": "Validates reset token, updates password, and revokes all active refresh sessions."
          }
        }
      ]
    },
    {
      "name": "Changelog",
      "description": "Changelog endpoints: CRUD operations, publishing, pinning, filtering, and search.",
      "item": [
        {
          "name": "Create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('changelog_id', jsonData.id);",
                  "}",
                  "if (jsonData.slug) {",
                  "    pm.collectionVariables.set('changelog_slug', jsonData.slug);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dark Mode & Performance Upgrades v2.0\",\n  \"content_markdown\": \"### What's New in v2.0\\n\\n- Seamless dark mode theme\\n- Real-time notification drawer\\n- 50% faster query times\",\n  \"category\": \"NEW\",\n  \"status\": \"DRAFT\",\n  \"version\": \"v2.0.0\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/changelog",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog"]
            },
            "description": "Creates a new changelog post (Admin only). Generates URL-friendly slug automatically."
          }
        },
        {
          "name": "List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog?page=1&limit=10&category=&search=",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "10"},
                {"key": "category", "value": ""},
                {"key": "search", "value": ""}
              ]
            },
            "description": "Paginated list of changelog posts. Public visitors see only PUBLISHED entries; authenticated admins see all statuses."
          }
        },
        {
          "name": "Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_slug}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "{{changelog_slug}}"]
            },
            "description": "Fetches single changelog entry by slug or ID."
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dark Mode & Performance Upgrades v2.0 (Updated)\",\n  \"content_markdown\": \"### What's New\\n\\n- Refined dark palette\\n- Fast widget embeds\",\n  \"category\": \"IMPROVED\",\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "{{changelog_id}}"]
            },
            "description": "Updates an existing changelog entry (Admin only)."
          }
        },
        {
          "name": "Publish",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}/publish",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "{{changelog_id}}", "publish"]
            },
            "description": "Transitions a changelog status to PUBLISHED and sets published_at timestamp (Admin only)."
          }
        },
        {
          "name": "Pin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}/pin",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "{{changelog_id}}", "pin"]
            },
            "description": "Pins post to top of listings (Admin only)."
          }
        },
        {
          "name": "Unpin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}/unpin",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "{{changelog_id}}", "unpin"]
            },
            "description": "Unpins sticky changelog post (Admin only)."
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/{{changelog_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "{{changelog_id}}"]
            },
            "description": "Deletes changelog entry and cascades deletion of attached emoji reactions (Admin only)."
          }
        }
      ]
    },
    {
      "name": "Reactions",
      "description": "User feedback emoji reaction endpoints.",
      "item": [
        {
          "name": "Add",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('reaction_id', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"changelog_id\": \"{{changelog_id}}\",\n  \"emoji\": \"🚀\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reactions",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reactions"]
            },
            "description": "Adds reaction (❤️, 🎉, or 🚀) to changelog post. Enforces unique constraint per user per changelog."
          }
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/reactions/changelog/{{changelog_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reactions", "changelog", "{{changelog_id}}"]
            },
            "description": "Retrieves aggregated reaction counts and current user's reaction state."
          }
        },
        {
          "name": "Remove",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reactions/{{reaction_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reactions", "{{reaction_id}}"]
            },
            "description": "Removes previously placed reaction."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "description": "What's New in-app notification center endpoints.",
      "item": [
        {
          "name": "Unread Count & Recent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications?limit=5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications"],
              "query": [{"key": "limit", "value": "5"}]
            },
            "description": "Returns unread count relative to user's last_viewed_changelog_date and recent update previews."
          }
        },
        {
          "name": "Mark Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/mark-read",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "mark-read"]
            },
            "description": "Updates user's last_viewed_changelog_date to current timestamp, resetting unread badge."
          }
        }
      ]
    },
    {
