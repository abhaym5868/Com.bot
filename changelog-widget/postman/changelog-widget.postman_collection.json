          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/feed?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "feed"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "limit", "value": "20"}
              ]
            },
            "description": "Public JSON feed of published updates with 5-minute Cache-Control header."
          }
        },
        {
          "name": "RSS 2.0 XML Feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/changelog/rss",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "changelog", "rss"]
            },
