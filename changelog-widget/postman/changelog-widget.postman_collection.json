          }
        }
      ]
    },
    {
      "name": "Widget",
      "description": "Widget studio customization and persistent configuration.",
      "item": [
        {
          "name": "Get Config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/widget/config",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "widget", "config"]
            },
            "description": "Retrieves the active embeddable widget studio configuration."
          }
        },
        {
          "name": "Update Config",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"widget_name\": \"What's New\",\n  \"launcher_text\": \"What's New\",\n  \"launcher_style\": \"pill\",\n  \"launcher_size\": \"md\",\n  \"icon\": \"sparkles\",\n  \"position\": \"bottom-right\",\n  \"offset_x\": 24,\n  \"offset_y\": 24,\n  \"theme\": \"system\",\n  \"accent_color\": \"#4F6EF7\",\n  \"border_radius\": 12,\n  \"shadow\": \"elevated\",\n  \"animation\": \"slide\",\n  \"show_badge\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/widget/config",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "widget", "config"]
            },
            "description": "Updates widget studio settings (Admin only)."
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "description": "Anonymous view tracking and dashboard metrics.",
      "item": [
        {
          "name": "Dashboard Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/analytics/dashboard",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "analytics", "dashboard"]
